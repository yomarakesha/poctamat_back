DATABASE_URL=sqlite+aiosqlite:///./dev.db
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
JWT_SECRET=dev-secret-change-me
PIN_PEPPER=dev-pepper-change-me

# Payments. The mock provider answers locally and signs its own webhooks with
# this secret; the real acquirer replaces both once the bank is named.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me

# SMS. "log" records the message and sends nothing, which is what development
# and the test suite use. "post_tm" sends for real and needs SMS_API_TOKEN —
# keep that token out of this file, it belongs in .env only.
SMS_PROVIDER=log
SMS_API_TOKEN=
SMS_BASE_URL=https://sms.post.tm
# Signs POST /webhooks/sms/{provider} (delivery reports). Provisional until
# post.tm documents its real callback scheme.
SMS_WEBHOOK_SECRET=dev-sms-webhook-secret-change-me

# Push. "log" records instead of sending, same as SMS. "fcm" needs all three
# fields below, copied out of a Firebase service account's JSON key
# (project_id, client_email, private_key) — keep them out of this file, they
# belong in .env only. FCM_PRIVATE_KEY is the PEM block on one line, wrapped in
# double quotes with its newlines written as \n, exactly as the JSON key
# already has it — e.g. FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
PUSH_PROVIDER=log
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Production / once postgresql-x64-18 is configured:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postamat

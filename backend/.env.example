DATABASE_URL=sqlite+aiosqlite:///./dev.db
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
JWT_SECRET=dev-secret-change-me
PIN_PEPPER=dev-pepper-change-me

# Payments. The mock provider answers locally and signs its own webhooks with
# this secret; the real acquirer replaces both once the bank is named.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me

# SMS. "log" records the message and sends nothing, which is what development
# and the test suite use. "post_tm" sends for real and needs SMS_API_TOKEN —
# keep that token out of this file, it belongs in .env only.
SMS_PROVIDER=log
SMS_API_TOKEN=
SMS_BASE_URL=https://sms.post.tm

# Production / once postgresql-x64-18 is configured:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postamat
